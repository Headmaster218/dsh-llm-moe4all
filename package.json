{
  "name": "dsh-llm-moe4all",
  "version": "0.2.0-alpha.17",
  "description": "DeepSeek Harness plugin for connecting to and managing a local MoE4All inference engine.",
  "license": "Apache-2.0",
  "author": "John / Headmaster218",
  "packageManager": "npm@10.9.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown --config tsdown.config.ts",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run build && npm test && npm pack --dry-run",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.1-rc.2 <0.1.2 || >=0.1.2-0 <0.1.3 || >=0.1.3-0 <0.1.4 || >=0.1.4-0 <0.1.5 || >=0.1.5-0 <0.1.6 || >=0.1.6-0 <0.1.7 || >=0.1.7-0 <0.2.0-0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "llm",
    "moe4all",
    "local-llm",
    "openai-compatible"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/dsh-credentials": ">=0.1.1-rc.2 <0.1.2 || >=0.1.2-0 <0.1.3 || >=0.1.3-0 <0.1.4 || >=0.1.4-0 <0.1.5 || >=0.1.5-0 <0.1.6 || >=0.1.6-0 <0.1.7 || >=0.1.7-0 <0.2.0-0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.1-rc.2 <0.1.2 || >=0.1.2-0 <0.1.3 || >=0.1.3-0 <0.1.4 || >=0.1.4-0 <0.1.5 || >=0.1.5-0 <0.1.6 || >=0.1.6-0 <0.1.7 || >=0.1.7-0 <0.2.0-0",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.1-rc.2 <0.1.2 || >=0.1.2-0 <0.1.3 || >=0.1.3-0 <0.1.4 || >=0.1.4-0 <0.1.5 || >=0.1.5-0 <0.1.6 || >=0.1.6-0 <0.1.7 || >=0.1.7-0 <0.2.0-0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.1-rc.2 <0.1.2 || >=0.1.2-0 <0.1.3 || >=0.1.3-0 <0.1.4 || >=0.1.4-0 <0.1.5 || >=0.1.5-0 <0.1.6 || >=0.1.6-0 <0.1.7 || >=0.1.7-0 <0.2.0-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.1-rc.2 <0.1.2 || >=0.1.2-0 <0.1.3 || >=0.1.3-0 <0.1.4 || >=0.1.4-0 <0.1.5 || >=0.1.5-0 <0.1.6 || >=0.1.6-0 <0.1.7 || >=0.1.7-0 <0.2.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.1-rc.2 <0.1.2 || >=0.1.2-0 <0.1.3 || >=0.1.3-0 <0.1.4 || >=0.1.4-0 <0.1.5 || >=0.1.5-0 <0.1.6 || >=0.1.6-0 <0.1.7 || >=0.1.7-0 <0.2.0-0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.1.1-rc.2 <0.1.2 || >=0.1.2-0 <0.1.3 || >=0.1.3-0 <0.1.4 || >=0.1.4-0 <0.1.5 || >=0.1.5-0 <0.1.6 || >=0.1.6-0 <0.1.7 || >=0.1.7-0 <0.2.0-0",
    "@deepseek-ai/dsh-settings": ">=0.1.1-rc.2 <0.1.2 || >=0.1.2-0 <0.1.3 || >=0.1.3-0 <0.1.4 || >=0.1.4-0 <0.1.5 || >=0.1.5-0 <0.1.6 || >=0.1.6-0 <0.1.7 || >=0.1.7-0 <0.2.0-0",
    "@deepseek-ai/schemastery": ">=3.18.1 <4",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-credentials": "0.1.5-rc.3",
    "@deepseek-ai/dsh-client-locale": "0.1.5-rc.3",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.5-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.3",
    "@deepseek-ai/dsh-host-webserver": "0.1.5-rc.3",
    "@deepseek-ai/dsh-llm-pi-ai": "0.1.5-rc.3",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.3",
    "@deepseek-ai/schemastery": "3.18.2",
    "@types/node": "24.19.0",
    "@types/react": "18.3.31",
    "react": "18.3.1",
    "tsdown": "0.22.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "unrun": "0.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Headmaster218/dsh-llm-moe4all.git"
  },
  "bugs": {
    "url": "https://github.com/Headmaster218/dsh-llm-moe4all/issues"
  },
  "homepage": "https://github.com/Headmaster218/dsh-llm-moe4all#readme",
  "dependencies": {
    "lucide-react": "0.468.0",
    "undici": "6.29.0"
  }
}
