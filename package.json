{
  "name": "dsh-llm-moe4all",
  "version": "0.1.0-alpha.1",
  "description": "DeepSeek Harness plugin for connecting to and managing a local MoE4All inference engine.",
  "license": "Apache-2.0",
  "author": "John / Headmaster218",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run build && npm test && npm pack --dry-run",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.1-rc.2 <0.1.2 || >=0.1.2-0 <0.1.3 || >=0.1.3-0 <0.1.4 || >=0.1.4-0 <0.1.5 || >=0.1.5-0 <0.1.6 || >=0.1.6-0 <0.1.7 || >=0.1.7-0 <0.2.0-0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "llm",
    "moe4all",
    "local-llm",
    "openai-compatible"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.1.1-rc.2 <0.1.2 || >=0.1.2-0 <0.1.3 || >=0.1.3-0 <0.1.4 || >=0.1.4-0 <0.1.5 || >=0.1.5-0 <0.1.6 || >=0.1.6-0 <0.1.7 || >=0.1.7-0 <0.2.0-0",
    "@deepseek-ai/schemastery": ">=3.18.1 <4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.1.5-rc.3",
    "@deepseek-ai/schemastery": "3.18.2",
    "@types/node": "^24.6.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Headmaster218/dsh-llm-moe4all.git"
  },
  "bugs": {
    "url": "https://github.com/Headmaster218/dsh-llm-moe4all/issues"
  },
  "homepage": "https://github.com/Headmaster218/dsh-llm-moe4all#readme"
}
